# 曲線に決まった後は坂昇格が適用されない (#140)。
#
# RailState.place の ASCENDING 昇格は shape がちょうど NORTH_SOUTH / EAST_WEST の
# ときだけ実行される [確定: 26.2 RailState.java:306-324]。第二段で曲線が確定した
# 後は「隣の 1 段上にレールがある」条件を満たしても坂にならない。
#
# 中心 (2,1,3) の南隣は同じ高さのレール、東隣は 1 段上 (3,2,3) のレール。
# getRail は 同じ高さ → 1 段上 → 1 段下 の順に探すので東も隣接として数えられ、
# 「南と東だけに隣接がある」条件で SOUTH_EAST が確定する。
# 対照 (z=7) は東の 1 段上だけなので EAST_WEST 経由で ascending_east になる。
#
# 期待値は実機 (fixture rail-curve-no-slope) が正。
meta {
  name: 曲線が確定すると坂昇格は起きない
  ref: #140 / fixture rail-curve-no-slope / 26.2 RailState.place の ASCENDING 昇格
}

fixture rail-curve-no-slope

state {
  # 南 (同じ高さ) + 東 (1 段上) → 曲線が勝つ
  t2 (2,1,3) rail[shape=south_east,waterlogged=false]
}

state {
  # 対照: 東 (1 段上) だけなら坂になる
  t4 (2,1,7) rail[shape=ascending_east,waterlogged=false]
}
