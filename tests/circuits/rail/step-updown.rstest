# **平坦のまま段差にしたレール**での探索と更新の届き方 (#129)。
#
# ⚠ 前提: この配置は **ハーネスの authored 設置 (scarpet の without_updates) でしか作れない**。
# 実際に手で敷くと段差の相手を置いた時点で手前が坂へ張り替わるので (rail/step-place.rstest)、
# 実プレイでこの状態にはならず、**信号を出した時点で斜め上に伝わる**
# (rail/slope-update.rstest)。ここで固定しているのは「もし平坦のまま段差になっていたら」
# という仮定の下での 2 つの性質:
#
# ① findPoweredRailSignal は「同じ高さ」と **1 段下** しか見ない [確定: 26.2 の
#    `isSameRailWithPower(pos) ? true : checkBelow && isSameRailWithPower(pos.below())`]。
#    ∴ 上のレールは下のレールを根として見つけられるが、下のレールは上を見つけられない
#    (斜め上は到達可能 / 斜め下は到達不能)。
# ② 斜めのセルは近隣更新の 6 方向に入らないので、レバーを入れただけでは判定し直されない。
#    真上にブロックを置いて更新を送ってはじめて確定する。
#
# 期待値は実機 (fixture powered-rail-step) が正。
meta {
  name: 段差越えの伝播は斜め上のみ (斜め下は通らない)
  ref: #129 / fixture powered-rail-step / 26.2 PoweredRailBlock.findPoweredRailSignal
}

fixture powered-rail-step

state {
  # レバーを入れた時点では、段差の相手には更新が届かないので点かない
  t4 (2,1,3) powered_rail[powered=true,shape=east_west,waterlogged=false]
  t4 (3,2,3) powered_rail[powered=false,shape=east_west,waterlogged=false]
  t4 (2,2,5) powered_rail[powered=true,shape=east_west,waterlogged=false]
  t4 (3,1,5) powered_rail[powered=false,shape=east_west,waterlogged=false]
}

state {
  # 斜め上に更新を送ると on になり、その先へも連鎖する
  t6 (3,2,3) powered_rail[powered=true,shape=east_west,waterlogged=false]
  t6 (4,2,3) powered_rail[powered=true,shape=east_west,waterlogged=false]
}

state {
  # 斜め下は更新を送っても off のまま (根に到達できない)
  t8 (3,1,5) powered_rail[powered=false,shape=east_west,waterlogged=false]
  t8 (4,1,5) powered_rail[powered=false,shape=east_west,waterlogged=false]
}
