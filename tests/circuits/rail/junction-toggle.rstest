# 置いた後でもレバー操作で分岐の向きが切り替わる (#142)。
#
# 通常レールの本来の使い方。RailBlock.updateState は
#   更新元ブロックが信号源 かつ 潜在接続がちょうど 3 方向
# のときだけ updateDir(first=false) を走らせる [確定: 26.2 RailBlock.java:29-33]。
# 北・南・東に隣接があるジャンクションの西隣に床レバーを置き、ON/OFF すると
# south_east ↔ north_east を往復する。レバーはレールではないので潜在接続には
# 数えられない (3 のまま)。
#
# 期待値は実機 (fixture rail-junction-toggle) が正。
meta {
  name: レバー操作で分岐の向きが往復する
  ref: #142 / fixture rail-junction-toggle / 26.2 RailBlock.updateState
}

fixture rail-junction-toggle

state {
  # 非通電で置くと south_east
  t2 (2,1,3) rail[shape=south_east,waterlogged=false]
}

state {
  # レバー ON → 同 tick で north_east
  t4 (1,1,3) lever[face=floor,facing=north,powered=true]
  t4 (2,1,3) rail[shape=north_east,waterlogged=false]
}

state {
  # レバー OFF → 同 tick で south_east に戻る
  t6 (1,1,3) lever[face=floor,facing=north,powered=false]
  t6 (2,1,3) rail[shape=south_east,waterlogged=false]
}
