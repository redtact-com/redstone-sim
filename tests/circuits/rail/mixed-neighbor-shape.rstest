# 形状の自動接続はレール種別をまたぐ (#140)。
#
# BaseRailBlock.isRail は BlockTags.RAILS 判定なので種別を問わない
# [確定: 26.2 BaseRailBlock.java:33-39]。一方、動力の連鎖は state.is(this) で
# 同種限定 (#138 / activator-mixed-chain.rstest)。**形状はまたぐ / 動力はまたがない**
# という非対称を、こちらは形状側から確定させる。
#
# 上段は powered_rail の東隣に通常レールを north_south で置き、
# 下段は通常レールの東隣に powered_rail を north_south で置く。
# どちらも隣に引かれて east_west になる。
#
# 期待値は実機 (fixture rail-mixed-neighbor-shape) が正。
meta {
  name: 形状の接続はレール種別をまたぐ
  ref: #140 / fixture rail-mixed-neighbor-shape / 26.2 BaseRailBlock.isRail
}

fixture rail-mixed-neighbor-shape

state {
  # powered_rail の隣に置いた通常レールが east_west になる
  t2 (3,1,3) rail[shape=east_west,waterlogged=false]
  t2 (2,1,3) powered_rail[powered=false,shape=east_west,waterlogged=false]
}

state {
  # 逆向きも同じ
  t4 (7,1,5) powered_rail[powered=false,shape=east_west,waterlogged=false]
  t4 (6,1,5) rail[shape=east_west,waterlogged=false]
}
