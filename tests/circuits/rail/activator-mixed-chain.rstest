# powered_rail と activator_rail の連鎖は混ざらない (#138)。
#
# 26.2 に ActivatorRailBlock は**存在しない**。activator_rail は powered_rail と
# 同じ PoweredRailBlock を別インスタンスとして登録しているだけで
# [確定: 26.2 Blocks.java:690 / :2893 — どちらも PoweredRailBlock::new]、
# レッドストーン挙動の差は連鎖探索が `state.is(this)` で
# **ブロックそのものの一致**を要求する点だけ
# [確定: 26.2 PoweredRailBlock.isSameRailWithPower]。
#
# 上段 (z=3) は レバー → powered_rail 2 本 → activator_rail 2 本、
# 下段 (z=5) は レバー → activator_rail 2 本 → powered_rail 2 本。
# どちらもレバー側の 2 本だけが on になり、異種の境目で連鎖が切れる。
# 形状の接続 (BlockTags.RAILS) は種別をまたぐが、**動力の連鎖はまたがない**。
#
# 期待値は実機 (fixture activator-rail-mixed-chain) が正。
meta {
  name: 動力の連鎖は同種のレール間でしか繋がらない
  ref: #138 / fixture activator-rail-mixed-chain / 26.2 PoweredRailBlock.isSameRailWithPower
}

fixture activator-rail-mixed-chain

state {
  # 上段: powered_rail 側だけ点く
  t2 (2,1,3) powered_rail[powered=true,shape=east_west,waterlogged=false]
  t2 (3,1,3) powered_rail[powered=true,shape=east_west,waterlogged=false]
  t2 (4,1,3) activator_rail[powered=false,shape=east_west,waterlogged=false]
  t2 (5,1,3) activator_rail[powered=false,shape=east_west,waterlogged=false]
}

state {
  # 下段: 逆向きでも同じ。activator_rail 同士は繋がるが powered_rail へは渡らない
  t4 (2,1,5) activator_rail[powered=true,shape=east_west,waterlogged=false]
  t4 (3,1,5) activator_rail[powered=true,shape=east_west,waterlogged=false]
  t4 (4,1,5) powered_rail[powered=false,shape=east_west,waterlogged=false]
  t4 (5,1,5) powered_rail[powered=false,shape=east_west,waterlogged=false]
}

state {
  # 上段のレバーは下段に影響しない (t2 時点で下段は全て off)
  t2 (2,1,5) activator_rail[powered=false,shape=east_west,waterlogged=false]
}
