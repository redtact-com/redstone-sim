# 坂 (ascending_*) を挟んでも動力は繋がる (#127)。
#
# findPoweredRailSignal は坂のとき進行方向の片側だけ 1 段上がり、その側では
# 「1 段下」を見ない (checkBelow=false) [確定: 26.2]。平地 → 坂 → 1 段上の平地
# と繋いだとき、段差を越えて 1 段上のレールまで powered になる。
#
# 期待値は実機 (fixture powered-rail-slope) が正。
meta {
  name: 坂を越えてパワードレールの動力が伝わる
  ref: #127 / fixture powered-rail-slope / 26.2 PoweredRailBlock.findPoweredRailSignal
}

fixture powered-rail-slope

state {
  t2 (2,1,3) powered_rail[powered=true,shape=east_west,waterlogged=false]
  t2 (3,1,3) powered_rail[powered=true,shape=ascending_east,waterlogged=false]
  # 段差を越えた先 (y=2)
  t2 (4,2,3) powered_rail[powered=true,shape=east_west,waterlogged=false]
  t2 (6,2,3) powered_rail[powered=true,shape=east_west,waterlogged=false]
}
