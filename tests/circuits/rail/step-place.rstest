# 段差の相手を **後から置く** と、その場で繋がって点く (#129)。
#
# レールを置くと RailState.place / connectTo が走り、**手前のレールが自動で坂に
# 張り替わる** (東隣の 1 段上にレールができるので east_west → ascending_east)。
# 坂になった時点で 2 本は形状的に繋がるので、動力もその場で伝わる = BUD は要らない。
# さらに置いた本人は onPlace で updateState を通るため、置いた瞬間に判定される
# [確定: 26.2 BaseRailBlock.onPlace / RailState.connectTo]。
#
# ∴ 普通に敷いていく限り段差は自然に坂になって繋がり、BUD を意識する必要はない。
# BUD が見えるのは rail/step-updown.rstest のように **平坦のまま段差を作り、
# 後から給電した**特殊なケースだけ。
#
# 期待値は実機 (fixture powered-rail-step-place) が正。
meta {
  name: 段差の相手を後から置くと坂に張り替わってその場で点く
  ref: #129 / fixture powered-rail-step-place / 26.2 RailState.connectTo
}

fixture powered-rail-step-place

state {
  # レバー ON の時点では手前 1 本だけ (相手はまだ無い)
  t2 (2,1,3) powered_rail[powered=true,shape=east_west,waterlogged=false]
}

state {
  # 斜め上に置くと、手前が坂へ張り替わり、置いた本人もその場で点く
  t4 (2,1,3) powered_rail[powered=true,shape=ascending_east,waterlogged=false]
  t4 (3,2,3) powered_rail[powered=true,shape=east_west,waterlogged=false]
}

state {
  # その先も置いた瞬間に点く
  t6 (4,2,3) powered_rail[powered=true,shape=east_west,waterlogged=false]
}
