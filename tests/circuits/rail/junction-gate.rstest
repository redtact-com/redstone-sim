# 向き再計算の門番: 潜在接続がちょうど 3 のときだけ (#142)。
#
# RailBlock.updateState の門番 2 条件のうち `countPotentialConnections() == 3` を
# 分離する [確定: 26.2 RailBlock.java:29-33 / RailState.java:127-137]。
#
# 左 (2,1,3) は北・南・東の 3 方向、右 (7,1,3) は四方全ての 4 方向ジャンクション。
# どちらも非通電で置くと後勝ちで south_east になる。そのあと真下の支持ブロックを
# レッドストーンブロックに差し替えて給電すると、setblock の近隣更新は**新しい
# ブロック**を運ぶ [確定: 26.2 ServerLevel.java:855-866] のでどちらにも信号源からの
# 更新が届く。それでも左だけが north_east に切り替わり、右は 4 方向なので
# 門番に弾かれて south_east のまま残る。
#
# 期待値は実機 (fixture rail-junction-gate) が正。
meta {
  name: 4 方向ジャンクションは給電しても切り替わらない
  ref: #142 / fixture rail-junction-gate / 26.2 RailState.countPotentialConnections
}

fixture rail-junction-gate

state {
  # どちらも非通電で south_east になる
  t2 (2,1,3) rail[shape=south_east,waterlogged=false]
  t4 (7,1,3) rail[shape=south_east,waterlogged=false]
}

state {
  # 3 方向: 給電で north_east へ
  t6 (2,1,3) rail[shape=north_east,waterlogged=false]
}

state {
  # 4 方向: 同じ給電操作でも south_east のまま
  t8 (7,1,3) rail[shape=south_east,waterlogged=false]
  t12 (7,1,3) rail[shape=south_east,waterlogged=false]
}
