# 蜂蜜でもフライングマシンは作れる。ただし電力の届け方を変える必要がある (#125 ②)。
#
# 蜂蜜は非導体なので「オブザーバー → 蜂蜜 → ピストン」の経路は使えない。
# 代わりにオブザーバーを蜂蜜の **上** (y=2) に置き、その出力を斜め下のピストンの
# 1 個上のマス (quasi 位置・空気) へ入れる。ピストンは QC で動力源化するが、
# 空気マスの変化では neighborChanged が飛ばないため、機械自身の動きによる更新で
# はじめて反応する = BUD の利用。
# オブザーバーは蜂蜜に吸着して運ばれ、着地時に再発火する (ObserverBlock.onPlace) ため
# 周期が続く。
#
# ∴ スライム版と同じく 10 tick ごとに +X へ 1 マス進む。
# 期待値は実機 (fixture flying-machine-honey-bud) が正。
meta {
  name: 蜂蜜フライングマシンが BUD/QC で 10gt ごとに 1 マス進む
  ref: #125 / fixture flying-machine-honey-bud / 26.2 PistonBaseBlock.getNeighborSignal
}

fixture flying-machine-honey-bud

state {
  t12 (5,1,5) honey_block
  t12 (6,1,5) sticky_piston[extended=false,facing=west]
  t12 (5,1,6) sticky_piston[extended=false,facing=east]
  t12 (6,1,6) honey_block
  t12 (5,2,5) observer[facing=north,powered=false]
  t12 (6,2,6) observer[facing=south,powered=false]
}

state {
  # 10 tick 後: 構造そのままで +X に 1 マス
  t22 (6,1,5) honey_block
  t22 (7,1,5) sticky_piston[extended=false,facing=west]
  t22 (6,1,6) sticky_piston[extended=false,facing=east]
  t22 (7,1,6) honey_block
  t22 (6,2,5) observer[facing=north,powered=false]
  t22 (7,2,6) observer[facing=south,powered=false]
  # 出発地点は空になっている
  t22 (4,1,5) air
  t22 (4,2,5) air
}
