# 向かい合う 2 個のオブザーバー (互いの状態変化を観測) は、更新なしで置いただけでは発振しない
# (#79 領域4)。
#
# 配置: A=(0,1,0) facing=east (B を観測)、B=(1,1,0) facing=west (A を観測)。互いの背面出力は
#   外側 (A の背面=西、B の背面=東) を向くため、A/B の観測面には「相手の powered 変化」しか
#   刺激源が無い。
#
# オブザーバーは形状更新でしか起動しない (02 §4.1)。ここでは 2 個とも更新なしで置くので、
#   どちらも先に変化せず、静止したままになる。これを固定する。
#   実機も同じ: fixture observer-mutual-clock-setblock のレーン 2 (z=3) が、2 個とも authored で
#   置いた対照で、全 tick 静止している。
#
# 置いて始動させる経路は、同じ fixture のレーン 1 が実機で見る。A だけ置いておき t2 に B を
#   /setblock すると、置いた B の予約 (#301) と、B が現れた形状更新による A の予約が t4 に並び、
#   2 個が同時に点く。以後は 6gt 周期で A が 2gt 先行する。先行する側は、t4 に A が予約を
#   もう 1 本積む (MC-189954) ことで決まる (02 §6 observer)。
meta {
  name: 相互オブザーバークロックは更新なしで置いただけでは静止する (始動は fixture observer-mutual-clock-setblock)
  ref: 02 §6 observer / §4.1 (PP のみ起動) / fixture observer-mutual-clock-setblock
}

circuit {
  (0,0,0) stone
  (1,0,0) stone
  (0,1,0) observer[facing=east,powered=false]     # A: B を観測、背面=西
  (1,1,0) observer[facing=west,powered=false]     # B: A を観測、背面=東
}

ticks 24

# 更新なしで置いただけでは全 tick 静止する。長い地平で発振が始まらないことを固定。
state {
  t0 (0,1,0) observer[facing=east,powered=false]
  t0 (1,1,0) observer[facing=west,powered=false]
  t6 (0,1,0) observer[facing=east,powered=false]
  t6 (1,1,0) observer[facing=west,powered=false]
  t12 (0,1,0) observer[facing=east,powered=false]
  t12 (1,1,0) observer[facing=west,powered=false]
  t18 (0,1,0) observer[facing=east,powered=false]
  t24 (1,1,0) observer[facing=west,powered=false]
}
